# 개발용 설정. 이 파일을 .env.local로 복사해서 쓴다. 비밀 값은 여기에 적지 않는다.
# 결제·로그인이 붙기 전에 화면을 확인하려고 둔 값이다.

# 1이면 뷰어에서 책 전체가 열린다. 비워 두면 앞 3장만 열린다(실제 서비스와 같다).
BOOKS_UNLOCK_ALL=

# 워터마크 모양을 확인할 때 쓰는 가짜 이메일. BOOKS_UNLOCK_ALL=1일 때만 보인다.
BOOKS_WATERMARK_SAMPLE=

# 관리자 화면(/admin) 비밀번호. 값은 여기 말고 .env.local에만 직접 적는다. 비워 두면 관리자 로그인이 꺼진다.
# 이 값을 바꾸면 이미 로그인한 관리자도 다시 로그인해야 한다. 12자 이상으로 정한다.
ADMIN_PASSWORD=
