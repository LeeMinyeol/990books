# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 검수용으로 내려받은 출처 본문(저작권이 있어 저장소에 올리지 않는다)
/.research/

# 설정값 이름만 적은 예시 파일은 저장소에 올린다
!.env.local.example

# 움직이는 그림(HyperFrames) 작업 파일. 글꼴은 용량이 커서 올리지 않고, 만든 MP4만 public/에 올린다
/motion/**/assets/fonts/
/motion/**/.hyperframes/
/motion/**/renders/
/motion/**/node_modules/
